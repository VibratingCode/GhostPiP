<Window x:Class="GhostPiP.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:GhostPiP.Views"
        Title="Ghost PiP" Width="1120" Height="720" MinWidth="860" MinHeight="560"
        Background="Transparent" Foreground="{StaticResource Text1}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="40" GlassFrameThickness="-1" ResizeBorderThickness="6" UseAeroCaptionButtons="True" CornerRadius="0"/>
  </WindowChrome.WindowChrome>
  <Grid x:Name="Root">
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D0141020" Offset="0"/>
        <GradientStop Color="#E00E0C14" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="84"/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>
    <Rectangle Grid.ColumnSpan="2" IsHitTestVisible="False">
      <Rectangle.Fill>
        <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="0.7" RadiusY="0.9">
          <GradientStop Color="#247EF0FF" Offset="0"/>
          <GradientStop Color="#00B69CFF" Offset="1"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>

    <DockPanel Margin="12,14,12,14">
      <Image DockPanel.Dock="Top" x:Name="Logo" Width="32" Height="32" Margin="0,0,0,18" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock x:Name="FloatingCount" DockPanel.Dock="Bottom" Style="{StaticResource T.Caption}" Foreground="{StaticResource Live}" TextAlignment="Center" TextWrapping="Wrap"/>
      <StackPanel WindowChrome.IsHitTestVisibleInChrome="True">
        <RadioButton x:Name="NavWindows" Style="{StaticResource Nav}" GroupName="Nav" IsChecked="True">
          <StackPanel><TextBlock Style="{StaticResource T.Icon}" FontSize="17" Text="{x:Static v:Ic.Pip}"/><TextBlock Text="Windows" Margin="0,4,0,0" TextAlignment="Center"/></StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavStudio" Style="{StaticResource Nav}" GroupName="Nav">
          <StackPanel><TextBlock Style="{StaticResource T.Icon}" FontSize="17" Text="{x:Static v:Ic.Crop}"/><TextBlock Text="Studio" Margin="0,4,0,0" TextAlignment="Center"/></StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavKeys" Style="{StaticResource Nav}" GroupName="Nav">
          <StackPanel><TextBlock Style="{StaticResource T.Icon}" FontSize="17" Text="{x:Static v:Ic.Keyboard}"/><TextBlock Text="Keys" Margin="0,4,0,0" TextAlignment="Center"/></StackPanel>
        </RadioButton>
        <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" GroupName="Nav">
          <StackPanel><TextBlock Style="{StaticResource T.Icon}" FontSize="17" Text="{x:Static v:Ic.Settings}"/><TextBlock Text="Settings" Margin="0,4,0,0" TextAlignment="Center"/></StackPanel>
        </RadioButton>
      </StackPanel>
    </DockPanel>

    <Grid Grid.Column="1" Margin="8,14,22,18">
      <v:GalleryPage x:Name="Gallery"/>
      <v:StudioPage x:Name="Studio" Visibility="Collapsed"/>
      <v:KeysPage x:Name="Keys" Visibility="Collapsed"/>
      <v:SettingsPage x:Name="SettingsView" Visibility="Collapsed"/>
    </Grid>
  </Grid>
</Window>
